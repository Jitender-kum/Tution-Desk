# ==============================================================================
# TuitionDesk WhatsApp Microservice — Staging Environment Template
# NOTE: Placeholders only. Do NOT commit real secrets or production credentials.
# ==============================================================================

# Port to listen on (default: 3005)
PORT=3005

# Host binding (127.0.0.1 ensures the microservice binds locally and is not exposed publicly)
WHATSAPP_HOST=127.0.0.1

# Staging Internal WhatsApp Service Secret (Must match Frontend and Backend WHATSAPP_INTERNAL_SECRET)
# Generate via: openssl rand -hex 32
WHATSAPP_INTERNAL_SECRET=replace_with_staging_whatsapp_internal_secret

# Engine Selection:
# - 'wwebjs' (default when unset): Legacy whatsapp-web.js + Puppeteer engine
# - 'baileys': Native WebSocket engine using @whiskeysockets/baileys
WHATSAPP_ENGINE=baileys

# Isolated Staging MongoDB Atlas Connection URI
# CRITICAL SAFETY REQUIREMENT: Must point to an ISOLATED staging database (e.g. tuitiondesk_staging or tuitiondesk_whatsapp_staging).
# NEVER point to production tuitiondesk_whatsapp database during Baileys evaluation.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tuitiondesk_staging?retryWrites=true&w=majority
