# ==============================================================================
# TuitionDesk Backend — Staging Environment Template
# NOTE: Placeholders only. Do NOT commit real secrets or production credentials.
# ==============================================================================

# Node Environment
NODE_ENV=production

# MongoDB Atlas Connection for Staging
# IMPORTANT: Use dedicated staging user credentials restricted exclusively to the 'tuitiondesk_staging' database.
# Syntax: mongodb+srv://<STAGING_USER>:<STAGING_PASSWORD>@<ATLAS_CLUSTER>.mongodb.net/tuitiondesk_staging?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://tuitiondesk_staging_user:replace_with_staging_db_password@your-atlas-cluster.mongodb.net/tuitiondesk_staging?retryWrites=true&w=majority

# Staging JWT Secret (Must match Frontend JWT_SECRET; generate via: openssl rand -hex 32)
JWT_SECRET=replace_with_staging_jwt_secret_min_32_characters

# Staging Internal WhatsApp Service Secret (Must match WhatsApp Microservice; generate via: openssl rand -hex 32)
WHATSAPP_INTERNAL_SECRET=replace_with_staging_whatsapp_internal_secret

# Internal URL to the staging WhatsApp microservice (unexposed to public web)
WHATSAPP_SERVICE_URL=http://127.0.0.1:3005

# WhatsApp Simulation Guard (MANDATORY IN STAGING: keeps real WhatsApp messages disabled)
WHATSAPP_MODE=simulation
ENABLE_LIVE_WHATSAPP=false

# Allowed Frontend Origins for CORS (Comma-separated list of permitted staging origins)
ALLOWED_ORIGINS=https://staging.yourdomain.com

# Public application URLs used for magic links and parent access URLs
NEXT_PUBLIC_APP_URL=https://staging.yourdomain.com
APP_URL=https://staging.yourdomain.com

# Payment Gateway Webhook Secret for Staging
YOUPI_WEBHOOK_SECRET=replace_with_staging_youpi_webhook_secret

# Cron Secret for Daily Automated Fee Generation (generate via: openssl rand -hex 32)
CRON_SECRET=replace_with_staging_cron_secret_min_32_characters
